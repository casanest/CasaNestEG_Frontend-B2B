      </RadioGroup.Option>

      {isSelected && (
        <div className="px-4 pb-4">
          {!showIframe ? (
            <div className="space-y-6">
              <div className="flex items-center gap-2 mb-4">
                <Lock className="w-4 h-4 text-green-600" />
