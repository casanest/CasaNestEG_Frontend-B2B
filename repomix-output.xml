            </LocalizedClientLink>
            <LocalizedClientLink href="/store">
              <Button size="large" className="w-full sm:w-auto  bg-[#043364] hover:bg-blue-900 text-white">
                {isArabic ? "متابعة التسوق" : "Continue Shopping"}
              </Button>
            </LocalizedClientLink>
          </div>

          {/* الدعم */}
          <div className="mt-6">
            <Help />
          </div>
        </div>
      </div>
    </div>
  )
}
