                  href={`/results/${search}`}
                  onClick={() => {
                    handleOpenDialogChange(false)
                  }}
                >
                  {search}
                </LocalizedClientLink>
              </div>
            </Button>
          )
        })
      ) : (
        <Text className="text-secondary">{locale === 'ar' ? 'لم يتم العثور على نتائج' : 'No results found'}</Text>
