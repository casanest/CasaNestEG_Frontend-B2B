"use client"

import { convertToLocale } from "@lib/util/money"
import { useLocale } from "next-intl"
import React from "react"

type CartTotalsProps = {
  totals: {
    total?: number | null
    subtotal?: number | null
    tax_total?: number | null
    shipping_total?: number | null
    discount_total?: number | null
    gift_card_total?: number | null
    currency_code: string
    shipping_subtotal?: number | null
  }
}

const CartTotals: React.FC<CartTotalsProps> = ({ totals }) => {
  const locale = useLocale()
  const isRTL = locale === "ar"

  const {
    currency_code,
    total,
    subtotal,
    tax_total,
    discount_total,
    gift_card_total,
    shipping_subtotal,
  } = totals

  return (
    <div
      className="flex flex-col gap-y-5 text-sm  p-4 bg-white rounded-lg border border-ui-border-base"
      dir={isRTL ? "rtl" : "ltr"}
    >
      <div className="flex flex-col gap-y-3 text-gray-700">
        <div className="flex items-center justify-between">
          <span className="font-medium">
            {isRTL
              ? "المجموع (بدون الشحن والضرائب)"
              : "Subtotal (excl. shipping and taxes)"}
          </span>
          <span
            data-testid="cart-subtotal"
            data-value={subtotal || 0}
            className="font-semibold"
          >
            {convertToLocale({ amount: subtotal ?? 0, currency_code })}
          </span>
        </div>

        {discount_total ? (
          <div className="flex items-center justify-between text-red-600">
            <span>{isRTL ? "خصم" : "Discount"}</span>
            <span
              className="font-semibold"
              data-testid="cart-discount"
              data-value={discount_total}
            >
              - {convertToLocale({ amount: discount_total ?? 0, currency_code })}
            </span>
          </div>
        ) : null}

        <div className="flex items-center justify-between">
          <span>{isRTL ? "الشحن" : "Shipping"}</span>
          <span
            data-testid="cart-shipping"
            data-value={shipping_subtotal || 0}
            className="font-semibold"
          >
            {convertToLocale({ amount: shipping_subtotal ?? 0, currency_code })}
          </span>
        </div>

        <div className="flex items-center justify-between">
          <span>{isRTL ? "الضرائب" : "Taxes"}</span>
          <span
            data-testid="cart-taxes"
            data-value={tax_total || 0}
            className="font-semibold"
          >
            {convertToLocale({ amount: tax_total ?? 0, currency_code })}
          </span>
        </div>

        {gift_card_total ? (
          <div className="flex items-center justify-between text-blue-600">
            <span>{isRTL ? "كارت الهدية" : "Gift Card"}</span>
            <span
              className="font-semibold"
              data-testid="cart-gift-card-amount"
              data-value={gift_card_total}
            >
              - {convertToLocale({ amount: gift_card_total ?? 0, currency_code })}
            </span>
          </div>
        ) : null}
      </div>

      <hr className="border-dashed border-gray-300 my-3 mb-1" />

      <div
        className="flex items-center justify-between text-lg font-bold text-gray-900"
      >
        <span>{isRTL ? "المجموع" : "Total"}</span>
        <span
          className="text-xl"
          data-testid="cart-total"
          data-value={total || 0}
        >
          {convertToLocale({ amount: total ?? 0, currency_code })}
        </span>
      </div>

    </div>
  )
}

export default CartTotals
