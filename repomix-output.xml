              <svg
                xmlns="http://www.w3.org/2000/svg"
                className={`h-4 w-4 transition-transform group-hover:translate-x-1 ${isRTL ? "rotate-180" : ""
                  }`}
                fill="none"
                viewBox="0 0 24 24"
