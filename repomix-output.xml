        details: `Cart completion error: ${completionError.message}`,
        cart_debug: {
          cart_id,
          items_count: itemsCount,
          cart_response: cartData
        }
      }, { status: 500 })
    }

  } catch (error: any) {
    console.error(`[Complete Order] Unexpected error:`, error)
