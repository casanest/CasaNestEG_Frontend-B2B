  title: 'Search',
  description: 'Explore all of our products.',
}

type Params = {
  params: Promise<{ query: string; countryCode: string }>
  searchParams: Promise<{
    sortBy?: string
    page?: string
    collection?: string
    type?: string
    material?: string
    price?: string
  }>
